[VARIABLES]
#include "include\UserInterface.mh"

WindowWidth    = 1070
WindowHeight   = 660
WindowTitle    = Kinematics Test
WindowFlags    = 0x0022
OpFlags        = 0x0001
Pollinterval   = 100             // ms interval for polling

// USB Connection
$Ctrl = Controller,0x0001,1,(1,USB,6,50,0x0,921600,1)

$Cmd   = SDO,0x0000,Ctrl,0x2201,USR_COMMAND,-,-,0
