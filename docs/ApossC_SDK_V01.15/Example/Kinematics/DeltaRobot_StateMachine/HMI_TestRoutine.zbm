$DspSmS= SDO,0x0001,Ctrl,0x2201,USR_DSP_STATUS,-,-,0

$SmStateText = Table,0x0000,("*MotorsOff",1,\
                             "*MotorsOn",10,\
                             "*Homing",20,\
                             "*Running",30,\
							 "*Running->PenDown",32,\
							 "*Running->PenUp",34,\
							 "*Running->WorkMove",36,\
							 "*Running->MachMove",38,\
							 "*Running->OsciOn",40,\
							 "*Running->OsciOff",42,\
							 "*Running->UpdateVel",44,\
							 "*Running->Erasing",46,\
							 "*Running->Drawing",48,\
							 "*Running->Show",50,\
                             "*HandMode",80)

// Font Definition --------------------------------------------------------------------------------
$Font  = Font,0x0000,(-11,0,0,0,700,0,0,0,0,0,0,0,0,"MS Shell Dlg 2")
$FSym   = Font,0x0000,(-20,0,0,0,400,0,0,0,0,0,0,0,0,"MS Shell Dlg 2")

$Zero  = Constant,0x0,0
$ArrNum = Constant,0x0,0

$CtrlBox = Box,"*Controller",-,20,15,570,70,0x0000,-
$CtrlStr = Text,"Controller:",CtrlBox,25,30,80,40,-1,-,0x0,Black,-
