$PScale   = SDO,0x0004,Ctrl,0x2201,USR_PATHSCALE,-,-,0

$DspWX  = SDO,0x0001,Ctrl,0x2201,USR_DSP_WRKPOSX,-,-,0
$DspWY  = SDO,0x0001,Ctrl,0x2201,USR_DSP_WRKPOSY,-,-,0
$DspWZ  = SDO,0x0001,Ctrl,0x2201,USR_DSP_WRKPOSZ,-,-,0
