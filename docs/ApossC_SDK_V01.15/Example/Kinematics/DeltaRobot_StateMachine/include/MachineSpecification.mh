/*********************************************************************
** Machine-specific Definitions
*
* In this file all robot specific kinematics parameters are defined.
*
*********************************************************************/

// Axis module number
#define AXIS1      0       		// Axis number of "Axis 1".
#define AXIS2      1      		// Axis number of "Axis 2".
#define AXIS3      2       		// Axis number of "Axis 3".

// Kinematic definition
#define DELTA_A		100		// Definition of length A [mm*10] → 99.69 mm
#define DELTA_B		100		// Definition of length B [mm*10] → 100.0 mm
#define DELTA_C		200		// Definition of length C [mm*10] → 200.0 mm
#define DELTA_D		33		// Definition of length D [mm*10] → 33.0 mm
#define DELTA_MIN	-10			// Minimum axis angle [°]
#define DELTA_MAX	130			// Maximum axis angle [°]

#define WCORD_ORIGIN_OFFSET_X	0		// Machine coordinate X offset from home position (machine)[mm]
#define WCORD_ORIGIN_OFFSET_Y	0		// Machine coordinate Y offset from home position (machine)[mm]
#define WCORD_ORIGIN_OFFSET_Z	-260	// Machine coordinate Z offset from home position (machine)[mm]
#define WCORD_ROT_XY			0		// Machine coordinate rotatio XY → work coordinate [°]
#define WCORD_SCALE				1		// Scaling machine coordinate → work coordinate [F]