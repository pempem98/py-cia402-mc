/*********************************************************************
** User Parameter / Interface
*
* User parameters are used to communicate with the Monitor
* dialog.  Please be aware of the fact that restarting the program
* DOES reinitialize the user parameters, but it does NOT update the
* user dialogue.  You must use the "Select Controller" button and
* reselect the controller to reinitialize the dialog.
*
*********************************************************************/

#define UPDATE_PERIOD   				500 	// ms - Update period for display
#define USER_FACTOR_SCALE 				10	// convert user units micrometers to milimeters (HMI)

// Command objects
#define USR_COMMAND     1				// SDO 0x2201 / 1
	#define CMD_MOTOFF      	1		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_MOTON       	2		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_HOME        	3		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_STOP        	4		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_UPDATE_VEL    	5		// valus for USR_COMMAND (0x2201 / 1)

	#define CMD_PATHSTART   	10		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_PATHNEXT    	11		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_PATHCONT    	12		// valus for USR_COMMAND (0x2201 / 1)

	#define CMD_MACHINE_MOVE    15		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_WORK_MOVE 		16		// valus for USR_COMMAND (0x2201 / 1)

	#define CMD_TEST_1  		40		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_TEST_2  		42		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_TEST_3			44		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_TEST_4    		46		// valus for USR_COMMAND (0x2201 / 1)
	#define CMD_TEST_5   		48		// valus for USR_COMMAND (0x2201 / 1)

